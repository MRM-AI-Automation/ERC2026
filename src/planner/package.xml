<?xml version="1.0"?>

<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>planner</name>
  <version>0.0.1</version>

  <description>
    ROS 2 autonomous rover planner providing sensor integration,
    ArUco following, GPS navigation, obstacle avoidance,
    and UDP motor relay functionality.
  </description>

  <maintainer email="vighneshreddysatti@gmail.com">
    mrmnavjet
  </maintainer>

<license>Apache-2.0</license>

  <!-- Build system -->

<buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->

<depend>rclcpp</depend> <depend>geometry_msgs</depend> <depend>sensor_msgs</depend> <depend>std_msgs</depend> <depend>std_srvs</depend> <depend>msgs</depend>

  <!-- Point Cloud Library ROS integration -->

<depend>pcl_conversions</depend> <depend>pcl_ros</depend>

  <!-- Testing dependencies -->

<test_depend>ament_lint_auto</test_depend>
<test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
